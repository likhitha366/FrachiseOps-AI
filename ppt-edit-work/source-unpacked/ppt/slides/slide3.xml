r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="5" name="TextBox 4"/><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="868680" y="1508760"/><a:ext cx="10332720" cy="4389120"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/></p:spPr><p:txBody><a:bodyPr wrap="square"><a:spAutoFit/></a:bodyPr><a:lstStyle/><a:p><a:pPr><a:spcAft><a:spcPts val="1400"/></a:spcAft><a:defRPr sz="1900"><a:solidFill><a:srgbClr val="232B37"/></a:solidFill></a:defRPr></a:pPr><a:r><a:t>• Important operational issues can be missed when communication is manual.</a:t></a:r></a:p><a:p><a:pPr><a:spcAft><a:spcPts val="1400"/></a:spcAft><a:defRPr sz="1900"><a:solidFill><a:srgbClr val="232B37"/></a:solidFill></a:defRPr></a:pPr><a:r><a:t>• Different events require different urgency levels and notification channels.</a:t></a:r></a:p><a:p><a:pPr><a:spcAft><a:spcPts val="1400"/></a:spcAft><a:defRPr sz="1900"><a:solidFill><a:srgbClr val="232B37"/></a:solidFill></a:defRPr></a:pPr><a:r><a:t>• Managers need proof that an alert was delivered, acknowledged and acted upon.</a:t></a:r></a:p><a:p><a:pPr><a:spcAft><a:spcPts val="1400"/></a:spcAft><a:defRPr sz="1900"><a:solidFill><a:srgbClr val="232B37"/></a:solidFill></a:defRPr></a:pPr><a:r><a:t>• Unresolved issues should not remain stuck with one person.</a:t></a:r></a:p><a:p><a:pPr><a:spcAft><a:spcPts val="1400"/></a:spcAft><a:defRPr sz="1900"><a:solidFill><a:srgbClr val="232B37"/></a:solidFill></a:defRPr></a:pPr><a:r><a:t>• Action plans provide a structured path from problem → owner → deadline → closure.</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="6" name="Rectangle 5"/><p:cNvSpPr/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="640080" y="6492240"/><a:ext cx="10881360" cy="13716"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:solidFill><a:srgbClr val="DCE1E8"/></a:solidFill><a:ln><a:noFill/></a:ln></p:spPr><p:style><a:lnRef idx="1"><a:schemeClr val="accent1"/></a:lnRef><a:fillRef idx="3"><a:schemeClr val="accent1"/></a:fillRef><a:effectRef idx="2"><a:schemeClr val="accent1"/></a:effectRef><a:fontRef idx="minor"><a:schemeClr val="lt1"/></a:fontRef></p:style><p:txBody><a:bodyPr rtlCol="0" anchor="ctr"/><a:lstStyle/><a:p><a:pPr algn="ctr"/></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="7" name="TextBox 6"/><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="10881360" y="6510528"/><a:ext cx="548640" cy="182880"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/></p:spPr><p:txBody><a:bodyPr wrap="none"><a:spAutoFit/></a:bodyPr><a:lstStyle/><a:p><a:pPr algn="r"><a:defRPr sz="900"><a:solidFill><a:srgbClr val="647082"/></a:solidFill></a:defRPr></a:pPr><a:r><a:t>3</a:t></a:r></a:p></p:txBody></p:sp></p:spTree></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>