generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model outlets {
  id           Int       @id @default(autoincrement())
  outlet_name  String    @db.VarChar(100)
  manager_name String    @db.VarChar(100)
  address      String
  city         String    @db.VarChar(100)
  state        String    @db.VarChar(100)
  country      String    @db.VarChar(100)
  postal_code  String?   @db.VarChar(10)
  latitude     Decimal   @db.Decimal(10, 7)
  longitude    Decimal   @db.Decimal(10, 7)
  is_active    Boolean?  @default(true)
  created_at   DateTime? @default(now()) @db.Timestamp(6)
  updated_at   DateTime? @default(now()) @db.Timestamp(6)
  sales        sales[]
}

model sales {
  id                  Int       @id @default(autoincrement())
  outlet_id           Int
  sale_date           DateTime  @db.Date
  total_orders        Int
  customer_count      Int
  gross_revenue       Decimal   @db.Decimal(12, 2)
  operating_cost      Decimal   @db.Decimal(12, 2)
  net_profit          Decimal   @db.Decimal(12, 2)
  average_order_value Decimal   @db.Decimal(10, 2)
  payment_cash        Decimal   @db.Decimal(10, 2)
  payment_card        Decimal   @db.Decimal(10, 2)
  payment_upi         Decimal   @db.Decimal(10, 2)
  created_at          DateTime? @default(now()) @db.Timestamp(6)
  outlets             outlets   @relation(fields: [outlet_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_outlet")
}
